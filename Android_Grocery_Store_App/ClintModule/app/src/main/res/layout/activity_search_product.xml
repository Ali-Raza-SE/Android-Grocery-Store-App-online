<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    tools:context=".SearchProductActivity">

    <EditText
        android:id="@+id/edtSearchProduct"
        android:layout_width="match_parent"
        android:layout_margin="20dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:hint="Search Products"
        android:padding="15dp"
        android:drawableEnd="@drawable/ic_search"
        android:background="@drawable/category_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSearchProducts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_marginTop="10dp"
        android:text="Search Product"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edtSearchProduct" />

    <TextView
        android:id="@+id/textProductNotFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Product Not Found"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/btnSearchProducts"
        app:layout_constraintStart_toStartOf="@+id/btnSearchProducts"
        app:layout_constraintTop_toBottomOf="@+id/btnSearchProducts" />


    <LinearLayout
        android:id="@+id/linearLayoutContainingSearchedData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/category_bg"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/textProductNotFound">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/searchedProductImage1"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Product Image"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/corn_image" />

            <ImageView
                android:id="@+id/searchedProductImage2"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Product Image"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/corn_image" />

            <ImageView
                android:id="@+id/searchedProductImage3"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Product Image"
                android:padding="10dp"
                android:scaleType="centerCrop"
                android:src="@drawable/corn_image" />
        </LinearLayout>

        <TextView

            android:id="@+id/searchedProductNamed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:text="Corn"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textStyle="bold" />

        <TextView

            android:id="@+id/searchedProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Price: "
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>